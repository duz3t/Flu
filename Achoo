-- Random sneeze sounds
local sneezeSoundIds = {
	"rbxassetid://100080597815253",
	"rbxassetid://93959552901723"
}

local function playSneezeSound()
	local sound = Instance.new("Sound")
	sound.SoundId = sneezeSoundIds[math.random(1, #sneezeSoundIds)]
	sound.Volume = 1
	sound.PlaybackSpeed = math.random(90, 110) / 100
	sound.Parent = character:WaitForChild("Head")
	sound:Play()

	task.delay(4, function()
		if sound then
			sound:Destroy()
		end
	end)
end

-- Green particle splatter
local function spawnSneezeParticles()
	local head = character:WaitForChild("Head")
	local look = humanoidRootPart.CFrame.LookVector
	local right = humanoidRootPart.CFrame.RightVector
	local up = humanoidRootPart.CFrame.UpVector

	for i = 1, 18 do
		local size = math.random(15, 45) / 100
		local particle = Instance.new("Part")

		particle.Shape = Enum.PartType.Ball
		particle.Size = Vector3.new(size, size, size)
		particle.Color = Color3.fromRGB(
			math.random(50, 90),
			math.random(160, 210),
			math.random(40, 70)
		)

		particle.Material = Enum.Material.SmoothPlastic
		particle.CanCollide = false
		particle.Anchored = false
		particle.CastShadow = false
		particle.CFrame = head.CFrame * CFrame.new(0, -0.3, -1)
		particle.Parent = workspace

		local spread =
			(right * math.random(-10, 10) / 10) +
			(up * math.random(-5, 10) / 10)

		particle.Velocity =
			(look * math.random(15, 35)) +
			spread * 15

		task.spawn(function()
			for j = 1, 10 do
				task.wait(0.05)
				particle.Transparency = j / 10
			end
			particle:Destroy()
		end)
	end
end

-- Sneeze logic
local function fakeSneeze()
	spawnSneezeParticles()
	playSneezeSound()

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 200, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = character:WaitForChild("Head")

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = "ACHOO!"
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = billboard

	local lookVector = humanoidRootPart.CFrame.LookVector

	humanoidRootPart.Velocity =
		-lookVector * knockbackPower +
		Vector3.new(0, knockbackPower / 3, 0)

	humanoidRootPart.CFrame =
		humanoidRootPart.CFrame * CFrame.Angles(0.3, 0, 0)

	sneezeCount += 1

	if statLabel then
		statLabel.Text = tostring(sneezeCount)
	end

	task.wait(1.5)
	billboard:Destroy()
end

